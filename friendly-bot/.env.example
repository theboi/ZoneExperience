# Copy this file to .env before running Friendly Bot locally.
# Never commit real values or the .env file.
# These placeholders are deliberately non-functional and must be replaced locally.
FRIENDLY_BOT_DATABASE_URL=postgresql+asyncpg://friendly_bot_user:replace_with_database_password@127.0.0.1:5432/friendly_bot
TELEGRAM_BOT_TOKEN=replace_with_telegram_bot_token
OPENROUTER_API_KEY=replace_with_openrouter_api_key
# Keep this false until the verified OpenRouter account/key logging setting is configured.
FRIENDLY_BOT_OPENROUTER_INPUT_OUTPUT_LOGGING_ATTESTATION=false
